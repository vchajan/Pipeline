# General
PROJECT_NAME=Big Data Pipeline Monitor
ENVIRONMENT=local

# Published ports
NGINX_PORT=8088
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379
KEYCLOAK_PORT=8080

# PostgreSQL
POSTGRES_DB=pipeline
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
DATABASE_URL=postgresql+psycopg://pipeline:pipeline@postgres:5432/pipeline
SQLITE_DATABASE_URL=sqlite:///./pipeline_monitor.db

# Redis/RQ
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=pipeline-runs

# Backend runtime
AUTH_MODE=keycloak
DEMO_AUTH_ENABLED=true
BACKEND_CORS_ORIGINS='["http://localhost:8088","http://localhost:5173"]'

# Worker and scheduler
WORKER_ID=local-worker
SCHEDULER_ID=local-scheduler
SCHEDULER_INTERVAL_SECONDS=30

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=pipeline-monitor
KEYCLOAK_CLIENT_ID=pipeline-monitor-web
KEYCLOAK_AUDIENCE=pipeline-monitor-web
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0

# Frontend
VITE_API_BASE_URL=/api
VITE_AUTH_MODE=keycloak
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=pipeline-monitor
VITE_KEYCLOAK_CLIENT_ID=pipeline-monitor-web
